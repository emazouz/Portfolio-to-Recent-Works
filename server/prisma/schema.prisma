// schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================
// User Management Models
// ================================

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String?
  role      Role      @default(USER)
  avatar    String?
  gender    Gender?
  birthDate DateTime?

  subscribeNewsletter      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  termsAgreed   Boolean   @default(false)
  lastLoginAt   DateTime?
  reviews Review[]
  // Security & Authentication
  refreshToken           String?   @unique
  resetToken             String?   @unique
  resetTokenExpiresAt    DateTime?
  emailVerificationToken String?   @unique

  // Account Status
  // rememberToken String?

  rememberToken          Boolean?            @default(false)
  rememberTokenExpiresAt DateTime? 
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  blogs   Blog[]
  emailVerifications     EmailVerification?
  @@map("users")
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}




enum EmailVerificationType {
  CHANGE_EMAIL
  EMAIL_VERIFICATION
}

// --- Email Verification Model ---
model EmailVerification {
  id        String   @id @default(uuid()) // المعرف الفريد للملف الشخصي
  email  String   @unique // البريد الإلكتروني الجديد (فريد)
  code      String   @unique // رمز التحقق
  expiresAt DateTime // تاريخ انتهاء صلاحية رمز التحقق
  type      EmailVerificationType
  user      User     @relation(fields: [userId], references: [id]) // علاقة مع المستخدم
  userId    String   @unique // مفتاح خارجي لربط الملف الشخصي بالمستخدم

  createdAt DateTime @default(now()) // تاريخ إنشاء الملف الشخصي
  updatedAt DateTime @updatedAt 
}




// ================================
// Portfolio & Projects Models
// ================================

model Project {
  id             Int              @id @default(autoincrement())
  title_en       String
  title_ar       String
  description_en String           @db.Text
  description_ar String           @db.Text
  imageUrl       String
  category       ProjectCategory?
  status         ProjectStatus    @default(IN_PROGRESS)
  liveUrl        String?
  githubUrl      String?
  technologies   String[]
  featured       Boolean          @default(false)
  sortOrder      Int?
  rating         Int?
  ratingsCount   Int?
  
  // SEO
  slug_en      String  @unique
  slug_ar      String  @unique
  metaTitle_en String?
  metaTitle_ar String?
  metaDesc_en  String?
  metaDesc_ar  String?

  
  reviews Review[]
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("projects")
}

enum ProjectStatus {
  COMPLETED
  IN_PROGRESS
  PLANNING
  ON_HOLD
}

enum ProjectCategory {
  WEB_DEVELOPMENT
  MOBILE_APP
  DESKTOP_APP
  UI_UX_DESIGN
  API_DEVELOPMENT
  OTHER
}
model Review {
  id         Int      @id @default(autoincrement())
  projectId Int
  userId     String
  rating     Int // 1-5 stars
  comment    String?  @db.Text
  createdAt  DateTime @default(now())
  
  verified   Boolean  @default(false)
  updatedAt  DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId]) 
  @@map("reviews")
}

// ================================
// Templates & E-commerce Models
// ================================


enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  IN_PROGRESS
}

model Blog {
  id         Int           @id @default(autoincrement())
  title_en   String
  title_ar   String
  content_en String        @db.Text
  content_ar String        @db.Text
  slug       String        @unique
  excerpt_en String?       @db.VarChar(500)
  excerpt_ar String?       @db.VarChar(500)
  category   BlogCategory?
  authorId   String?
  published  Boolean       @default(false)
  featured   Boolean       @default(false)
  metaTitle_en String?
  metaTitle_ar String?
  metaDesc_en  String? 
  metaDesc_ar  String? 
  status      BlogStatus  @default(DRAFT)
  tags       String[]
  imageUrl   String?
  previewImages String[]
  readTime   Int? // وقت القراءة بالدقائق
  views      Int           @default(0)
  likes      Int           @default(0)
  blogLikes BlogLike[]

  // SEO
  keywords     String[]

  // Scheduling
  publishDate DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  author   User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  comments Comment[]

  @@map("blogs")
}



model BlogLike {
  id        Int      @id @default(autoincrement())
  blogId    Int
  userId    String
  isLiked   Boolean  @default(false)
  createdAt DateTime @default(now())

  blog Blog @relation(fields: [blogId], references: [id])

  @@unique([blogId, userId]) 
}


model Comment {
  id        Int      @id @default(autoincrement())
  blogId    Int
  userId    String? // null إذا كان تعليق من زائر غير مسجل
  name      String // اسم المعلق
  email     String // بريد المعلق
  content   String   @db.Text
  approved  Boolean  @default(false)
  parentId  Int? // للردود على التعليقات
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blog    Blog      @relation(fields: [blogId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@map("comments")
}

enum BlogCategory {
  WEB_DEVELOPMENT
  MOBILE_DEVELOPMENT
  UI_UX_DESIGN
  PROGRAMMING_TIPS
  TUTORIALS
  NEWS
  PERSONAL
  TECHNOLOGY
  OTHER
}

// ================================
// Communication Models
// ================================

model ContactMessage {
  id          Int           @id @default(autoincrement())
  name        String
  email       String
  subject     String?
  message     String        @db.Text
  type        MessageType   @default(GENERAL)
  status      MessageStatus @default(UNREAD)
  respondedAt DateTime?
  response    String?       @db.Text
  createdAt   DateTime      @default(now())

  @@map("contact_messages")
}

enum MessageType {
  GENERAL
  PROJECT
  JOB_OFFER
  COLLABORATION
  CONSULTATION
}

enum MessageStatus {
  UNREAD
  READ
  RESPONDED
  SPAM
}

// ================================
// Configuration Models
// ================================

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String @db.Text
  type  String @default("string") // string, number, boolean, json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ================================
// Analytics Models
// ================================

model Analytics {
  id        Int      @id @default(autoincrement())
  event     String // نوع الحدث: page_view, download, purchase, etc.
  entity    String? // المعرف للكيان المرتبط بالحدث
  userId    String? // معرف المستخدم (إذا كان مسجلاً)
  data      Json? // بيانات إضافية
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@map("analytics")
}
